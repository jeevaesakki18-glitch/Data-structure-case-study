
#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
#include <limits>
using namespace std;

int main() {
    vector<string> items;
    int choice;
    string item;

    do {
        cout << "\n--- Shopping List ---\n";
        cout << "1. Add item\n";
        cout << "2. Remove item\n";
        cout << "3. Search item\n";
        cout << "4. Display all items\n";
        cout << "5. Exit\n";
        cout << "Enter your choice: ";

        if (!(cin >> choice)) {
            cout << "Invalid input!\n";
            break;
        }

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        switch (choice) {
            case 1:
                cout << "Enter item to add: ";
                getline(cin, item);
                items.push_back(item);
                cout << "Item added successfully!\n";
                break;

            case 2: {
                cout << "Enter item to remove: ";
                getline(cin, item);

                auto it = find(items.begin(), items.end(), item);

                if (it != items.end()) {
                    items.erase(it);
                    cout << "Item removed successfully!\n";
                } else {
                    cout << "Item not found!\n";
                }
                break;
            }

            case 3:
                cout << "Enter item to search: ";
                getline(cin, item);

                if (find(items.begin(), items.end(), item)
                    != items.end()) {
                    cout << "Item found!\n";
                } else {
                    cout << "Item not found!\n";
                }
                break;

            case 4:
                if (items.empty()) {
                    cout << "Shopping list is empty.\n";
                } else {
                    cout << "\nShopping List Items:\n";
                    for (int i = 0; i < items.size(); i++) {
                        cout << i + 1 << ". "
                             << items[i] << "\n";
                    }
                }
                break;

            case 5:
                cout << "Exiting program.\n";
                break;

            default:
                cout << "Invalid choice!\n";
        }

    } while (choice != 5);

    return 0;
}
